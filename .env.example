# Managed Postgres (Neon / Railway / RDS). Must include ?sslmode=require for
# most managed providers.
DATABASE_URL=postgresql://user:pass@host:5432/ipo_tracker?sslmode=require

# Signing key for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every outstanding access token (refresh tokens
# survive, because they are opaque and stored server-side).
JWT_SECRET=

# Shared secret the external scheduler presents on POST /jobs/* as x-job-secret.
# Same generation command as above. Never ship this to the app.
JOB_SECRET=

PORT=8080
NODE_ENV=development

# Deep link the password-reset email points at. Must match the app's scheme.
PASSWORD_RESET_URL=ipotracker://reset-password

# Comma-separated origins allowed by CORS. A native app sends no Origin header
# so this only matters for the web build; leave empty to allow none.
CORS_ORIGINS=
